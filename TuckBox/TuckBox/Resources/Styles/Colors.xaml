<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand / Primary Palette -->
    <Color x:Key="Primary">#FF8A42</Color>
    <!-- Warm TuckBox orange -->
    <Color x:Key="PrimaryDark">#E36F23</Color>
    <!-- Darker orange accent -->
    <Color x:Key="PrimaryLight">#FFD5B3</Color>
    <!-- Soft orange tint -->
    <Color x:Key="PrimaryText">#1F2933</Color>
    <!-- Deep neutral text -->
    <Color x:Key="Secondary">#FFF7F1</Color>
    <!-- Pale background -->
    <Color x:Key="SecondaryText">#5B5B5B</Color>
    <!-- Muted secondary text -->
    <Color x:Key="Accent">#00A896</Color>
    <!-- Teal accent for highlights -->

    <!-- Neutral Grays -->
    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray900">#111827</Color>

    <!-- Brush references (for use in styles) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryText}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryText}" />

    <!-- Global UI Styles -->
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
    </Style>

    <Style TargetType="Frame">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="BackgroundColor" Value="White" />
    </Style>

</ResourceDictionary>
