<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ===== TuckBox Brand (new) ===== -->
    <Color x:Key="TuckPrimary">#FF8A42</Color>
    <Color x:Key="TuckPrimaryDark">#E36F23</Color>
    <Color x:Key="TuckPrimaryLight">#FFD5B3</Color>
    <Color x:Key="TuckSurface">#FFF7F1</Color>
    <Color x:Key="TuckText">#1F2933</Color>
    <Color x:Key="TuckMuted">#6B7280</Color>
    <Color x:Key="TuckAccent">#00A896</Color>

    <!-- ===== Neutral Grays ===== -->
    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray900">#111827</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- ===== Legacy keys preserved (pointed to new palette) ===== -->
    <Color x:Key="Primary">#FF8A42</Color>
    <Color x:Key="PrimaryDark">#E36F23</Color>
    <Color x:Key="PrimaryDarkText">#1F2933</Color>
    <Color x:Key="Secondary">#FFF7F1</Color>
    <Color x:Key="SecondaryDarkText">#6B7280</Color>
    <Color x:Key="Tertiary">#E36F23</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1F1F1F</Color>

    <!-- ===== Brush aliases (old + new) ===== -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource TuckPrimaryLight}"/>

    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>

    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- New named brushes for convenience -->
    <SolidColorBrush x:Key="TuckPrimaryBrush" Color="{StaticResource TuckPrimary}" />
    <SolidColorBrush x:Key="TuckPrimaryDarkBrush" Color="{StaticResource TuckPrimaryDark}" />
    <SolidColorBrush x:Key="TuckSurfaceBrush" Color="{StaticResource TuckSurface}" />
    <SolidColorBrush x:Key="TuckTextBrush" Color="{StaticResource TuckText}" />
    <SolidColorBrush x:Key="TuckMutedBrush" Color="{StaticResource TuckMuted}" />
    <SolidColorBrush x:Key="TuckAccentBrush" Color="{StaticResource TuckAccent}" />

    <!-- A few safe global styles -->
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource TuckPrimary}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TuckText}" />
    </Style>

    <Style TargetType="Frame">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="BackgroundColor" Value="White" />
    </Style>
</ResourceDictionary>