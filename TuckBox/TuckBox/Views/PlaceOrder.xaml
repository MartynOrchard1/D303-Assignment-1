<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TuckBox.Views.PlaceOrder"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:TuckBox.Models"
    Title="Place Order">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label x:Name="StatusLabel" Text="Loading..." FontAttributes="Bold" />

            <Picker x:Name="CityPicker" Title="Select City" />
            <Picker x:Name="SlotPicker" Title="Select Delivery Time Slot" />

            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Picker x:Name="AddressPicker" Title="Select Delivery Address" HorizontalOptions="FillAndExpand" />
                <Button Text="ADD" Clicked="OnAddAddressClicked" />
            </HorizontalStackLayout>

            <!-- Food list -->
            <CollectionView x:Name="FoodsList" ItemsLayout="VerticalList">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Food">
                        <!-- Card -->
                        <Frame
                            Margin="10,6"
                            Padding="14"
                            CornerRadius="16"
                            HasShadow="True"
                            BackgroundColor="#FFF7F1"
                            BorderColor="#FFD5B3">

                            <VerticalStackLayout x:Name="RowRoot" Spacing="10">

                                <!-- Title + price -->
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Food_Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#2B0B98" />
                                    <Label Text="{Binding Price, StringFormat='${0:F2}'}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#1F2933"
                                           HorizontalOptions="EndAndExpand" />
                                </HorizontalStackLayout>

                                <!-- Description -->
                                <Label Text="{Binding Description}"
                                       FontSize="13"
                                       TextColor="#555"
                                       LineBreakMode="WordWrap" />

                                <!-- Divider -->
                                <BoxView HeightRequest="1" BackgroundColor="#FFD5B3" />

                                <VerticalStackLayout Spacing="4" Margin="0,4,0,0">
                                    <!-- Option title -->
                                    <Label Text="{Binding Option_Key, StringFormat='{0} Options'}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#2B0B98"
                                       Margin="0,4,0,2"/>

                                    <!-- Contextual hint -->
                                    <Label x:Name="OptionHint"
                                       FontSize="12"
                                       TextColor="Gray"
                                       Margin="0,0,0,4">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Option_Key}" Value="spice">
                                                <Setter Property="Text" Value="Choose how spicy you'd like it." />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Option_Key}" Value="dressing">
                                                <Setter Property="Text" Value="Select your preferred salad dressing." />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Option_Key}" Value="bread">
                                                <Setter Property="Text" Value="Pick your bread type for the sandwich." />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Option_Key}" Value="chilli">
                                                <Setter Property="Text" Value="Add the right amount of chilli flakes." />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <!-- Radio button choices -->
                                    <FlexLayout Direction="Row"
                                    Wrap="Wrap"
                                    AlignItems="Center"
                                    JustifyContent="Start"
                                    BindableLayout.ItemsSource="{Binding Option_Values}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Border Stroke="#FFD5B3"
                                                StrokeThickness="1"
                                                BackgroundColor="#FFF"
                                                StrokeShape="RoundRectangle 12"
                                                Margin="2">
                                                    <RadioButton
                                                    Content="{Binding .}"
                                                    Value="{Binding .}"
                                                    GroupName="{Binding Source={x:Reference RowRoot}, Path=BindingContext.Food_ID}"
                                                    CheckedChanged="OnOptionChecked"
                                                    TextColor="#1F2933"
                                                    Visual="Material"
                                                    Padding="6,2"
                                                    FontSize="13"/>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </VerticalStackLayout>

                                <!-- Quantity row -->
                                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                    <Button Text="−"
                                            WidthRequest="36" HeightRequest="36"
                                            CornerRadius="12"
                                            BackgroundColor="#FF8A42"
                                            TextColor="White"
                                            Clicked="OnMinusClicked" />
                                    <Label x:Name="QtyLabel"
                                           Text="0"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           WidthRequest="32"
                                           HorizontalTextAlignment="Center" />
                                    <Button Text="+"
                                            WidthRequest="36" HeightRequest="36"
                                            CornerRadius="12"
                                            BackgroundColor="#FF8A42"
                                            TextColor="White"
                                            Clicked="OnPlusClicked" />
                                    <Label Text="{Binding Price, StringFormat='${0:F2}'}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           HorizontalOptions="EndAndExpand"
                                           TextColor="#1F2933" />
                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Place Order" Clicked="OnPlaceOrderClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
