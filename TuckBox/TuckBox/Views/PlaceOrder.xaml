<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TuckBox.Views.PlaceOrder"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:TuckBox.Models"
    Title="Place Order">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label x:Name="StatusLabel" Text="Loading..." FontAttributes="Bold" />

            <Picker x:Name="CityPicker" Title="Select City" />
            <Picker x:Name="SlotPicker" Title="Select Delivery Time Slot" />

            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Picker x:Name="AddressPicker" Title="Select Delivery Address" HorizontalOptions="FillAndExpand" />
                <Button Text="ADD" Clicked="OnAddAddressClicked" />
            </HorizontalStackLayout>

            <!-- Food list -->
            <CollectionView x:Name="FoodsList" ItemsLayout="VerticalList">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Food">
                        <!-- Card -->
                        <Frame
                            Margin="10,6"
                            Padding="14"
                            CornerRadius="16"
                            HasShadow="True"
                            BackgroundColor="#FFF7F1"
                            BorderColor="#FFD5B3">

                            <!-- Keep your same names/bindings so code-behind works -->
                            <VerticalStackLayout x:Name="RowRoot" Spacing="10">

                                <!-- Title + price -->
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Food_Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#2B0B98" />
                                    <Label Text="{Binding Price, StringFormat='${0:F2}'}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#1F2933"
                                           HorizontalOptions="EndAndExpand" />
                                </HorizontalStackLayout>

                                <!-- Description -->
                                <Label Text="{Binding Description}"
                                       FontSize="13"
                                       TextColor="#555"
                                       LineBreakMode="WordWrap" />

                                <!-- Divider -->
                                <BoxView HeightRequest="1" BackgroundColor="#FFD5B3" />

                                <!-- Options -->
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Option_Key}" FontAttributes="Bold"/>
                                    <HorizontalStackLayout
                                        x:Name="OptionsHost"
                                        Spacing="12"
                                        BindableLayout.ItemsSource="{Binding Option_Values}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton
                                                Content="{Binding .}"
                                                Value="{Binding .}"
                                                GroupName="{Binding Source={x:Reference RowRoot}, Path=BindingContext.Food_ID}"
                                                CheckedChanged="OnOptionChecked" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>


                                <!-- Quantity row -->
                                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                    <Button Text="−"
                                            WidthRequest="36" HeightRequest="36"
                                            CornerRadius="12"
                                            BackgroundColor="#FF8A42"
                                            TextColor="White"
                                            Clicked="OnMinusClicked" />
                                    <Label x:Name="QtyLabel"
                                           Text="0"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           WidthRequest="32"
                                           HorizontalTextAlignment="Center" />
                                    <Button Text="+"
                                            WidthRequest="36" HeightRequest="36"
                                            CornerRadius="12"
                                            BackgroundColor="#FF8A42"
                                            TextColor="White"
                                            Clicked="OnPlusClicked" />
                                    <Label Text="{Binding Price, StringFormat='${0:F2}'}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           HorizontalOptions="EndAndExpand"
                                           TextColor="#1F2933" />
                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Place Order" Clicked="OnPlaceOrderClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
